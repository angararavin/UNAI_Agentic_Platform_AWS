#!/usr/bin/env bash
# ==========================================================================
# UNAI — local environment loader TEMPLATE (safe to commit; no secrets).
# Copy to env.sh and fill in your own values:   cp env.sh.example env.sh
# Then:   cd unai-app && source env.sh && node server.js
# env.sh itself is gitignored so your credentials never get committed.
# ==========================================================================

# --- Pin the interpreter: a venv that has BOTH warehouse drivers ----------
# One-time setup:
#   python3 -m venv ~/unai-venv
#   source ~/unai-venv/bin/activate && pip install --upgrade pip
#   pip install snowflake-connector-python "databricks-sql-connector>=3.0"
if [ -d "$HOME/unai-venv" ]; then
  source "$HOME/unai-venv/bin/activate"
fi

# --- Databricks -----------------------------------------------------------
export DATABRICKS_SERVER_HOSTNAME=<your-workspace>.cloud.databricks.com
export DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse-id>
export DATABRICKS_TOKEN=dapi-xxxxxxxxxxxxxxxx       # never commit this
export DATABRICKS_CATALOG=workspace
export DATABRICKS_SCHEMA=unai_supply_chain

# --- Snowflake ------------------------------------------------------------
export SNOWFLAKE_ACCOUNT=<ORG>-<ACCOUNT>
export SNOWFLAKE_USER=<your_user>
export SNOWFLAKE_PASSWORD='<your_password>'         # or SNOWFLAKE_TOKEN for key-pair/SSO
export SNOWFLAKE_WAREHOUSE=<your_warehouse>
export SNOWFLAKE_DATABASE=UNAI
export SNOWFLAKE_SCHEMA=SUPPLY_CHAIN
export SNOWFLAKE_ROLE=SYSADMIN

# --- Neo4j ontology store (AuraDB Free) -----------------------------------
# export NEO4J_URI=neo4j+s://<xxxx>.databases.neo4j.io
# export NEO4J_USER=neo4j
# export NEO4J_PASSWORD='<from AuraDB>'

# --- LLM router (quota-aware failover across your provider keys) -----------
# The app tries providers in LLM_ROUTER_ORDER; on 429/quota/error it fails over.
export LLM_ROUTER_ORDER=openai,mistral             # order = failover priority
export OPENAI_API_KEY='sk-...'
export MISTRAL_API_KEY='your-mistral-key'
# --- Claude / Anthropic (economizer: auto prompt-caching of shared envelope) ---
# Adds Claude WITHOUT replacing the defaults — append it to LLM_ROUTER_ORDER to use:
#   LLM_ROUTER_ORDER=openai,mistral,claude
# export ANTHROPIC_API_KEY='sk-ant-...'
# export ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Prompt caching is AUTOMATIC for Claude — no extra flag. To meter the real savings:
#   source env.sh && (cd ../supply-chain-workbench && GATEWAY_MODEL=claude-sonnet-5 python3 token_benchmark.py)
# Without ANTHROPIC_API_KEY it runs MODELED (estimated); with the key it runs live/Measured.
# export LLM_MODEL_SIMPLE=claude-haiku-4-5-20251001   # light tasks → cheap Claude
# export LLM_MODEL_COMPLEX=claude-sonnet-5            # heavy reasoning → larger Claude

# --- Optional: app + architecture gate passwords --------------------------
# export APP_PASSWORD='your-app-login-password'
# export ARCH_PASSWORD='your-architecture-tab-password'
