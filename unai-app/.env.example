# =============================================================================
# UNAI vector store configuration  (copy to .env; all values have safe defaults)
# -----------------------------------------------------------------------------
# UNAI ships a vector store out of the box. Leave these as-is to use the bundled
# Qdrant (the product default). Change UNAI_VECTOR_PROVIDER to point at any of
# the built-in connectors instead. If the chosen backend is unreachable, UNAI
# automatically falls back to its built-in EMBEDDED index, so the app still runs.
# =============================================================================

# Which backend UNAI retrieves from.
#   qdrant (default) | embedded | chroma | weaviate | pinecone | milvus | pgvector | databricks | azure
UNAI_VECTOR_PROVIDER=qdrant

# Endpoint for the chosen backend (ignored for "embedded").
#   qdrant docker:   http://qdrant:6333        (inside the compose network)
#   qdrant local:    http://localhost:6333
UNAI_VECTOR_URL=http://qdrant:6333

# Collection / index name to read & write.
UNAI_VECTOR_COLLECTION=unai_kb

# API key / token for managed backends (Pinecone, Azure, Databricks, secured Qdrant).
UNAI_VECTOR_API_KEY=

# --- App options (optional) ---
PORT=8080
# APP_PASSWORD=
# EXPERT_PASSWORD=unai-demo
