env.sh
**/env.sh
!env.sh.example
!**/env.sh.example
# ...but DO allow the public verification key to be committed
!copyright/UNAI_PUBLIC_KEY.pem
credentials.json
# Customer-facing API keys issued by this running Studio instance (real,
# live secrets — see unai-app/customer_api.js) + other machine-local runtime
# state that's regenerated automatically on boot and would be stale/
# misleading in a fresh clone anyway.
customer_api_keys.json
customer_agents.json
.foundry_running.json
.foundry_stopped.json
unai_relaunch.json
**/unai_relaunch.json
unai_measure_report.json
**/unai_measure_report.json

